---
import "../styles/global.css"
import { Font } from "astro:assets"

interface Props {
  title?: string
}

const { title } = Astro.props
const pageTitle = title
  ? `${title} – ABCs of Consumerism`
  : "Lachlan's ABCs of Consumerism"
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" preload />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lachlan Campbell" />
    <meta property="og:url" content="https://lachlanjc.com/" />
    <meta name="twitter:site" content="@lachlanjc" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta name="twitter:title" content={pageTitle} />
    <link
      rel="icon"
      href="https://github.com/lachlanjc.png"
      type="image/png"
      sizes="any"
    />
    <link
      rel="apple-touch-icon"
      href="https://github.com/lachlanjc.png"
      type="image/png"
      sizes="180x180"
    />
  </head>
  <body>
    <main class="container mx-auto max-w-xl py-12 px-4">
      <slot />
    </main>
  </body>
</html>
