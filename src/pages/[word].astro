---
import { getCollection, render } from "astro:content"
import Layout from "../layouts/Layout.astro"

export async function getStaticPaths() {
  const words = await getCollection("words")
  const sortedWords = words.sort((a, b) => a.data.title.localeCompare(b.data.title))

  return sortedWords.map((entry, idx) => {
    const prev = idx > 0 ? sortedWords[idx - 1] : null
    const next = idx < sortedWords.length - 1 ? sortedWords[idx + 1] : null

    return {
      params: { word: entry.id },
      props: { entry, prev, next },
    }
  })
}

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const title = entry.data.title
---

<Layout title={title}>
  <a
    href="/"
    class="text-lg opacity-50 transition-opacity hover:opacity-70 title"
  >
    &larr; ABCs of Consumerism
  </a>
  <h1
    class="text-4xl mt-4 mb-6 stylized"
    style={`view-transition-name: ${title};`}
  >
    {title}
    <span class="text-2xl opacity-50 font-mono ml-2">
      {entry.data.type}
    </span>
  </h1>
  <article
    class="prose prose-invert prose-lg prose-p:text-pretty prose-blockquote:font-mono prose-a:font-medium prose-hr:my-8"
  >
    <Content />
  </article>

  <nav class="mt-12 pt-8 border-t border-white/20 grid grid-cols-2 gap-4">
    {
      prev ? (
        <a
          href={`/${prev.id}`}
          class="text-lg opacity-70 transition-opacity hover:opacity-100 title"
        >
          &larr; {prev.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a
          href={`/${next.id}`}
          class="text-lg opacity-70 transition-opacity hover:opacity-100 title justify-self-end text-right"
        >
          {next.data.title} &rarr;
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Layout>
