---
import { getCollection, render } from "astro:content"
import { Image } from "astro:assets"
import Layout from "../layouts/Layout.astro"

const books = await getCollection("books")
const sortedBooks = books.sort((a, b) => a.data.title.localeCompare(b.data.title))
const renderedBooks = await Promise.all(
  sortedBooks.map(async (book) => ({
    book,
    ...(await render(book)),
  }))
)
---

<Layout>
  <a
    href="/"
    class="text-lg opacity-50 transition-opacity hover:opacity-70 title"
  >
    &larr; ABCs of Consumerism
  </a>

  <h1 class="text-4xl mt-4 mb-2 stylized">Books</h1>
  <p class="opacity-70">
    A small bookshelf behind this project.
  </p>

  <div class="mt-12 border-t border-white/20">
    {
      renderedBooks.map(({ book, Content }) => (
        <a
          href={book.data.bookshopUrl}
          target="_blank"
          rel="noreferrer"
          class="block border-b border-white/20 transition-colors hover:bg-white/10 -mx-3 px-3 py-6"
        >
          <div class="flex gap-5 items-start">
            <Image
              src={book.data.cover}
              alt={`Cover of ${book.data.title}`}
              class="w-24 sm:w-28 h-auto rounded-md border border-white/10 bg-white/5 shrink-0"
            />

            <div class="min-w-0">
              <h2 class="text-2xl text-pretty leading-tight stylized">
                {book.data.title}
              </h2>
              <p class="mt-1 text-sm font-mono opacity-70">
                {book.data.author}
                <span class="opacity-50"> · </span>
                {book.data.yearPublished}
              </p>

              <article class="prose prose-invert prose-lg prose-p:text-pretty prose-a:font-medium mt-4">
                <Content />
              </article>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Layout>


